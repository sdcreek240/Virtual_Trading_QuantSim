{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:studio": "npx prisma studio --port 5555 --browser none",
    "db:generate": "prisma generate",
    "db:reset": "prisma migrate reset",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "npx tsx prisma/seed.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "docker:up": "docker-compose -f ../docker/docker-compose.yml down -v && docker-compose -f ../docker/docker-compose.yml up -d --build && echo 'Waiting for database...' && sleep 5 && npm run db:push && npm run db:seed",
    "docker:down": "docker-compose -f ../docker/docker-compose.yml down -v",
    "docker:restart": "docker-compose -f ../docker/docker-compose.yml restart",
    "docker:logs": "docker-compose -f ../docker/docker-compose.yml logs -f",
    "docker:ps": "docker-compose -f ../docker/docker-compose.yml ps",
    "docker:rebuild": "docker-compose -f ../docker/docker-compose.yml up -d --build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/jwt": "^10.0.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "ioredis": "^5.10.1",
    "pg": "^8.20.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "prisma": "^7.7.0",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  }
}
